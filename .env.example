# Copy to .env and fill in. NEVER commit .env or any key file.

# A funded Shannon testnet key. Used only to sign your own transactions locally.
# Get testnet tUSDC (collateral) + STT (gas) from the SomniaHacks dev group (use the faucet topic):
#   https://t.me/+XHq0F0JXMyhmMzM0
PRIVATE_KEY=0x...

# Somnia Shannon testnet (chain 50312). Defaults below usually work.
RPC_URL=https://dream-rpc.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# Indexer (GraphQL) — the SDK requires one at construction. Every read/write in
# this starter is on-chain, so the value is never actually called here. The public
# Shannon testnet endpoint is pre-filled (also published in the markets-sdk README);
# change it only if you run your own indexer.
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Intelligence & LLM Engine
NEWS_API_KEY=your_news_api_key
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Deterministic Risk & Execution Settings
DRY_RUN=false
MIN_CONFIDENCE=0.72
COOLDOWN_MS=900000
DAILY_LOSS_CAP_USD=25
MAX_POSITION_SIZE=10
POLL_INTERVAL_MS=60000
